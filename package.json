{
  "name": "wsc-talent-pool",
  "version": "1.0.0",
  "private": true,
  "description": "Turns conference attendees into a ranked, explained candidate list for an open role, ready for HubSpot import.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pipeline": "tsx cli/run-pipeline.ts",
    "pipeline:all": "tsx cli/run-pipeline.ts --all",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
