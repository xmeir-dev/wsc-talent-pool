{
  "name": "wsc-talent-pool",
  "version": "1.0.0",
  "private": true,
  "description": "Turns conference attendees into a ranked, explained candidate list for an open role, ready for HubSpot import.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "node scripts/build-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-docs.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "demo:integrations": "vite --config vite.demo.config.ts",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "pipeline": "tsx cli/run-pipeline.ts",
    "pipeline:all": "tsx cli/run-pipeline.ts --all",
    "test": "vitest run",
    "verify:xlsx": "XLSX_READER_REQUIRED=1 vitest run tests/import-export/xlsx-libreoffice.test.ts",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "docs:site": "node scripts/build-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "marked": "18.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@meir-labs/ui-kit": "file:vendor/meir-labs-ui-kit-0.3.2.tgz",
    "country-flag-icons": "1.6.20",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
